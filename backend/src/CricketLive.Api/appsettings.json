{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Archive": "Data Source=cricket-live.db"
  },
  "RateLimits": {
    "RequestsPerMinute": 120,
    "ConcurrentStreams": 4
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CricketData": {
    "BaseUrl": "https://api.cricapi.com/v1/",
    "TimeoutSeconds": 10,
    "DailyHitBudget": 100
  },
  "Live": {
    "PollSeconds": 30,
    "IdleSeconds": 5,
    "HeartbeatSeconds": 20
  },
  "Cricbuzz": {
    "Enabled": false,
    "AutoResolve": false,
    "BaseUrl": "https://www.cricbuzz.com",
    "TimeoutSeconds": 8,
    "CacheSeconds": 20,
    "DirectoryCacheMinutes": 30
  },
  "CricbuzzApi": {
    "Enabled": false,
    "BaseUrl": "https://cricbuzz-cricket.p.rapidapi.com",
    "Host": "cricbuzz-cricket.p.rapidapi.com",
    "TimeoutSeconds": 10,
    "MonthlyBudget": 200,
    "ReservedForFinished": 60,
    "LiveCacheSeconds": 300,
    "FinishedCacheHours": 24
  }
}
