# Base URL of the Cricket Live .NET API.
#
# Required. The build fails without it rather than defaulting, because Vite inlines VITE_*
# variables at build time and an unset one becomes the literal string "undefined" — producing a
# bundle where every request goes to undefined/api/... and reporting success while it does.
#
# Absolute, with a scheme, and no trailing slash: it is joined to paths that already start with
# one.
#
# `.env.development` supplies this for `npm run dev`. A production build has no .env file of its
# own, so pass it in the environment:
#
#   VITE_API_BASE_URL=https://api.example.com npm run build
#
# Never put the cricket provider's API key here, or in any other file in this folder. Vite inlines
# every VITE_* variable into the client bundle, which would ship the key to every visitor. The
# provider is only ever called from our own API.
VITE_API_BASE_URL=http://localhost:5140
